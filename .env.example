# Google Firebase Cloud Firestore & Storage Configuration
# Create a free project at https://console.firebase.google.com
# Then paste your project credentials below or add them into Vercel Project Settings > Environment Variables:

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_APP_ID=your_app_id

# Supabase Cloud Configuration (Storage for photos & videos + Database)
# Create a free project at https://supabase.com
# Find these in Supabase Dashboard > Project Settings > API:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_SUPABASE_BUCKET=future-events
